// Schema do Prisma — Codex do Aventureiro
// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Etapa 1 — Usuários e autenticação
// -----------------------------------------------------------------------------

/// Configuração global da mesa (linha única, `id = "main"`).
/// Guarda o contador de liberações de Level Up e o nível inicial da mesa.
model GameConfig {
  id             String   @id @default("main")
  ///
  /// Incrementa a cada clique do mestre em "Liberar Level Up". O personagem
  /// guarda a última liberação que já usou, então cada jogador sobe UM nível
  /// por liberação — e o mestre libera de novo sem precisar bloquear antes.
  levelUpRelease Int      @default(0)
  ///
  /// Nível em que os personagens começam a mesa. Quando é maior que 1, o
  /// assistente de criação aplica os níveis 2 até este ao concluir a montagem
  /// (sem depender da liberação de Level Up do mestre).
  startingLevel  Int      @default(1)
  ///
  /// Anotações PRIVADAS do mestre sobre a mesa (o "bloco de notas" dele).
  /// NÃO fazem parte do GameConfigDto: o GET /api/game é acessível ao jogador,
  /// então elas têm rotas próprias (`/api/game/notes`, só MASTER).
  masterNotes    String   @default("")
  ///
  /// Mostra as denominações EXTRAS (PL/pp e PE/ep) no bloco de moedas da ficha.
  /// Desligado (padrão), a interface mostra só PO (gp), PP (sp) e PC (cp); os
  /// valores das cinco denominações existem sempre no banco.
  extraCoins     Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@map("game_config")
}

/// Papel do usuário na mesa.
/// - PLAYER: cria e gerencia apenas a própria ficha.
/// - MASTER: enxerga todas as fichas e tem o painel de controle.
enum Role {
  PLAYER
  MASTER
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  displayName  String
  passwordHash String
  role         Role       @default(PLAYER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  character    Character?

  @@index([role])
  @@map("users")
}

// -----------------------------------------------------------------------------
// Etapa 2 — Ficha de personagem
//
// Modelagem híbrida: campos simples e muito consultados ficam em colunas
// (nome, nível, atributos, HP, CA) e as coleções maiores ficam em JSONB,
// validadas por Zod na aplicação. Isso deixa a edição inline e a sincronização
// em tempo real simples, sem dezenas de tabelas auxiliares.
// -----------------------------------------------------------------------------

model Character {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ///
  /// Criação encerrada: enquanto for `false`, o jogador ainda está montando o
  /// personagem e pode mexer em identidade, atributos, proficiências e classes.
  /// Com `true`, só o estado de jogo continua editável pelo jogador (PV atual,
  /// PV temporário, usos de recursos/espaços, anotações, avatar e movimentação
  /// de itens) — o resto só muda pelo Level Up ou pelo mestre.
  creationFinalized Boolean @default(false)

  ///
  /// Rascunho do assistente de criação (ver shared/creation.ts): modo escolhido
  /// (novo/existente), passo alcançado, as rolagens de 4d6 e os valores-base
  /// dos atributos. Só vale enquanto `creationFinalized` for falso — é o que
  /// permite fechar o navegador e retomar de onde parou.
  creationDraft Json @default("{}")

  // Identidade
  name String @default("Novo Personagem")
  ///
  /// Raça em TEXTO LIVRE (o `name` do catálogo de criação, ex.:
  /// "Anão (Anão da Colina)"). Continua como está — NÃO é derivada dos campos
  /// estruturados abaixo e NÃO é migrada nesta etapa.
  race String @default("")
  ///
  /// Raça do catálogo ESTRUTURADO (src/modules/shared/races/), pelo `id`.
  /// Ainda não é preenchido por nada: é a fundação para os próximos passos.
  raceId       String?
  /// Sub-raça do catálogo estruturado, pelo `id` (dentro da raça acima).
  subraceId    String?
  /// Escolhas da raça (ex.: ancestralidade dracônica): { [id da escolha]: id da opção }.
  raceChoices  Json   @default("{}")
  ///
  /// Raça PERSONALIZADA do mestre (tabela CustomRace). Quando preenchida, ela
  /// tem prioridade sobre `raceId`/`subraceId` na leitura da raça.
  customRaceId String?
  customRace   CustomRace? @relation(fields: [customRaceId], references: [id], onDelete: SetNull)
  ///
  /// Idiomas conhecidos (texto), concedidos pela raça e pelo antecedente.
  /// Não há mecânica associada — é exibido na ficha.
  languages       String[] @default([])
  ///
  /// Visão no escuro em METROS (0 = sem), concedida pela raça/sub-raça.
  /// Ponto de exibição — não há sistema de iluminação no jogo.
  darkvision      Int      @default(0)
  ///
  /// Tipos de dano resistidos concedidos pela RAÇA (13 canônicos de
  /// shared/attacks.ts). Somados às resistências de classe no combate.
  raceResistances String[] @default([])
  ///
  /// Classes do personagem (multiclasse): [{ classKey, subclass, level }].
  /// O nível de cada entrada é o nível NAQUELA classe; o nível total do
  /// personagem é a soma deles. Vazio = ficha sem classe ainda.
  /// Ver src/modules/shared/classes.ts.
  classes    Json   @default("[]")
  background String @default("")
  alignment  String @default("")
  experience Int    @default(0)
  ///
  /// Última liberação de Level Up já usada por este personagem.
  /// Comparado com `GameConfig.levelUpRelease` para saber se o jogador ainda
  /// pode subir de nível na liberação atual.
  lastLevelUpRelease Int @default(0)
  ///
  /// Histórico do que CADA nível concedeu: PV ganho (dado + Constituição + o
  /// ajuste retroativo de Constituição), Aumento de Atributo/Talento, escolhas
  /// de característica, subclasse, perícia de multiclasse e proficiências
  /// somadas naquele nível.
  ///
  /// É o que permite ao MESTRE reduzir um nível revertendo exatamente o que ele
  /// deu (POST /api/characters/:id/level-down). Níveis anteriores a esta coluna
  /// ficam sem registro — o downgrade estima o PV e avisa na resposta.
  /// Ver src/modules/shared/level-history.ts.
  levelHistory Json @default("[]")

  // Atributos (1 a 30)
  strength     Int @default(10)
  dexterity    Int @default(10)
  constitution Int @default(10)
  intelligence Int @default(10)
  wisdom       Int @default(10)
  charisma     Int @default(10)

  // Pontos de vida e defesa
  hpCurrent Int @default(1)
  hpMax     Int @default(1)
  hpTemp    Int @default(0)
  ///
  /// OVERRIDE da Classe de Armadura, definido pelo mestre. `0` = sem override:
  /// a CA é calculada (armadura equipada + atributos + defesa sem armadura).
  /// Só o mestre grava aqui — a CA não é um valor fixo da ficha.
  armorClass      Int @default(0)
  initiativeBonus Int @default(0)
  ///
  /// Deslocamento em metros (sistema métrico), COM frações: 25 pés = 7,5 m,
  /// 35 pés = 10,5 m. A raça/sub-raça define o valor base no passo 3.
  speed           Float @default(9)

  // Coleções (JSONB) — ver src/modules/characters/characters.schema.ts
  skills    Json @default("{}") //  { [skill]: { proficient, expertise } }
  saves     Json @default("{}") //  { [ability]: boolean }
  ///
  /// Proficiências de armadura, arma e ferramenta (texto exibido na ficha).
  /// A PRIMEIRA classe concede o conjunto completo do nível 1; entrar numa
  /// classe nova por multiclasse concede só o conjunto reduzido do PHB p.164.
  /// Ver CLASS_PROFICIENCIES em src/modules/shared/classes.ts.
  proficiencies Json @default("{}") //  { armor: string[], weapons: string[], tools: string[] }
  ///
  /// Proficiências SIMPLES em ferramentas, pelos ids estáveis do catálogo
  /// (src/modules/shared/tools). Guarda só o id (ex.: "thieves-tools"); a
  /// Expertise tem campo próprio (`expertiseSkills`, com o prefixo `tool:`).
  /// Nasce vazio: nenhuma classe/raça/antecedente concede ferramenta sozinha
  /// nesta etapa. É campo de CONSTRUÇÃO — só o Level Up e o mestre o mudam.
  toolProficiencies String[] @default([])
  inventory Json @default("[]") //  [{ id, name, description, quantity, weight, equipped }]
  spells    Json @default("{}") //  { list: [...], slots: { "1": { max, used } } }
  attacks   Json @default("[]") //  [{ id, name, damage: { count, sides, bonus, type }, attackBonus, notes, finesse, ranged, legacy? }]
  features  Json @default("[]") //  [{ id, name, source, description }]
  notes     String @default("")
  /// Estado de runtime da classe: toggles ativos (ex.: Fúria) e usos gastos.
  classState Json @default("{}") //  { active: string[], used: { [id]: number } }
  ///
  /// Carteira de moedas: { pp, gp, ep, sp, cp }, inteiros >= 0 (padrão 0).
  /// Só o MESTRE altera por PATCH; o jogador gasta, troca e transfere pelos
  /// endpoints dedicados — ver src/modules/shared/coins.ts.
  coins     Json @default("{ \"pp\": 0, \"gp\": 0, \"ep\": 0, \"sp\": 0, \"cp\": 0 }")

  /// URL pública do avatar enviado pelo próprio jogador (`uploads/characters/...`).
  avatarUrl String @default("")

  /// Incrementado a cada alteração; ajuda a ordenar eventos em tempo real.
  version    Int         @default(1)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  combatants Combatant[]

  @@map("characters")
}

/// Raça PERSONALIZADA criada pelo mestre (Prompt 2.10).
///
/// Segue o formato do catálogo estruturado (`src/modules/shared/races/`), sem
/// sub-raças: bônus fixos de atributo, deslocamento, tamanho, visão no escuro,
/// resistências, idiomas e traços em TEXTO LIVRE (sem `mechanicalEffect`
/// estruturado — diferente das raças oficiais).
model CustomRace {
  id                   String   @id @default(cuid())
  name                 String
  description          String   @default("")
  /// Incrementos fixos de atributo: `[{ ability, amount }]`.
  abilityScoreIncrease Json     @default("[]")
  /// Deslocamento em metros, com frações (padrão do sistema: 9 = 30 pés).
  speed                Float    @default(9)
  /// Tamanho: 'Small' ou 'Medium'.
  size                 String   @default("Medium")
  /// Visão no escuro em metros (0 = sem).
  darkvision           Int      @default(0)
  /// Tipos de dano resistidos (13 canônicos de shared/attacks.ts).
  damageResistances    Json     @default("[]")
  /// Idiomas conhecidos (texto informativo).
  languages            Json     @default("[]")
  /// Quantos idiomas à escolha a raça concede.
  bonusLanguageChoices Int      @default(0)
  /// Traços em texto livre: `[{ name, description }]`.
  traits               Json     @default("[]")
  version              Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  characters Character[]

  @@index([name])
  @@map("custom_races")
}

// -----------------------------------------------------------------------------
// Etapa 3 — Criaturas e NPCs (cadastrados pelo mestre)
//
// Segue a mesma modelagem híbrida da ficha: atributos e vitais em colunas,
// ataques/resistências/imunidades em JSONB. As criaturas ficam disponíveis
// para o sistema de combate da Etapa 4.
//
// Criaturas e NPCs compartilham os mesmos campos; o que os separa é o `kind`.
// NPCs são entidades narrativas e podem ser vinculados a localidades.
// -----------------------------------------------------------------------------

/// Separa monstros de combate (CREATURE) de personagens narrativos (NPC).
enum CreatureKind {
  CREATURE
  NPC
}

/// Região do mundo (reino, floresta, continente...) que agrupa localidades.
/// Tem descrição, anotações e imagens próprias; as criaturas/NPCs ficam
/// sempre nas localidades, nunca soltos na região.
model Region {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  /// Anotações livres do mestre sobre a região.
  notes       String   @default("")
  /// Lista de imagens: [{ url, name }]. Os arquivos ficam em `uploads/`.
  images      Json     @default("[]")
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  localities Locality[]

  @@index([name])
  @@map("regions")
}

/// Local do mundo (cidade, masmorra, taverna...) dentro de uma região.
model Locality {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  /// Lista de imagens: [{ url, name }]. Os arquivos ficam em `uploads/`.
  images      Json     @default("[]")
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Região à qual a localidade pertence. Apagar a região apaga as localidades.
  regionId String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  creatures Creature[]
  combats   Combat[]

  @@index([name])
  @@index([regionId])
  @@map("localities")
}

model Creature {
  id String @id @default(cuid())

  // Identificação
  name            String
  kind            CreatureKind @default(CREATURE)
  type            String @default("") // ex.: Humanoide, Besta, Dragão
  challengeRating String @default("") // Nível de Desafio (ND), ex.: "1/2", "5"

  // Atributos (1 a 30)
  strength     Int @default(10)
  dexterity    Int @default(10)
  constitution Int @default(10)
  intelligence Int @default(10)
  wisdom       Int @default(10)
  charisma     Int @default(10)

  // Pontos de vida e defesa
  hpCurrent  Int @default(1)
  hpMax      Int @default(1)
  armorClass Int @default(10)
  /// Deslocamento em metros (sistema métrico).
  speed      Int @default(9)

  // Coleções (JSONB) — ver src/modules/shared/attacks.ts
  attacks     Json @default("[]") // [{ id, name, damage: { count, sides, bonus, type }, attackBonus, notes, finesse, ranged, legacy? }]
  resistances Json @default("[]") // tipos de dano resistidos
  immunities  Json @default("[]") // tipos de dano imunes
  description String @default("")

  /// URL pública do ícone/retrato da criatura/NPC (`uploads/creatures/...`).
  imageUrl String @default("")

  /// Localidades às quais esta criatura/NPC pertence (uma ou mais).
  localities Locality[]

  /// Incrementado a cada alteração; ajuda a ordenar eventos em tempo real.
  version    Int         @default(1)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  combatants Combatant[]

  @@index([name])
  @@index([kind])
  @@map("creatures")
}

/// Item do catálogo central gerenciado pelo mestre (armas, poções, tesouros...).
/// Pode ter um sprite e ser enviado direto para o inventário de um jogador.
model Item {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  /// Peso em quilogramas (aceita frações, como 0.25).
  weight      Float    @default(0)
  /// Categoria validada na aplicação (ex.: Arma, Poção, Tesouro).
  category    String   @default("Item Geral")
  /// Raridade do PHB 2014 (common, uncommon, rare, very_rare, legendary,
  /// artifact). `null` = item sem raridade classificada. Ver ITEM_RARITIES em
  /// src/modules/shared/item-details.ts.
  rarity      String?
  /// O item exige sintonização (PHB 2014). Propriedade MANUAL do mestre,
  /// independente da raridade. Ver src/modules/shared/item-details.ts.
  requiresAttunement Boolean @default(false)
  /// URL pública do sprite do item (`uploads/items/...`).
  imageUrl    String   @default("")
  /// Atributos específicos da categoria: dano, CA adicional, rolagem de efeito...
  /// Ver src/modules/shared/item-details.ts.
  details     Json     @default("{}")
  /// Preço em peças de ouro, prata e cobre (informação exclusiva do mestre).
  priceGold   Int      @default(0)
  priceSilver Int      @default(0)
  priceCopper Int      @default(0)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@index([rarity])
  @@map("items")
}

// -----------------------------------------------------------------------------
// Etapa 4 — Combate
//
// Um combate ativo por vez. O HP NÃO é duplicado aqui: o combatente guarda
// apenas identidade e iniciativa, e o HP é lido ao vivo da ficha ou da criatura.
// Assim não existe segunda fonte de verdade para os pontos de vida.
// -----------------------------------------------------------------------------

enum CombatStatus {
  PENDING_INITIATIVE // aguardando todas as iniciativas serem roladas
  ACTIVE // ordem montada, turnos em andamento
  ENDED
}

enum CombatantKind {
  CHARACTER
  CREATURE
}

/// Um combate ativo por vez.
///
/// O índice único PARCIAL `combats_one_active_key` (expressão constante `(1)`
/// com `WHERE status <> 'ENDED'`, criado na migration
/// `20261003050000_single_active_combat`) garante no banco que só exista uma
/// linha com status diferente de ENDED. O Prisma não expressa índice único
/// parcial no schema, então ele vive só na migration — por isso a checagem de
/// aplicação em `startCombat` continua existindo (caminho rápido) e o erro
/// P2002 do INSERT é traduzido para o mesmo 409.
model Combat {
  id           String       @id @default(cuid())
  status       CombatStatus @default(PENDING_INITIATIVE)
  round        Int          @default(1)
  /// Posição na ordem calculada (ordenada por iniciativa).
  currentIndex Int          @default(0)

  /// Localidade onde o combate acontece (opcional, informada na preparação).
  localityId String?
  locality   Locality? @relation(fields: [localityId], references: [id], onDelete: SetNull)

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  endedAt    DateTime?
  combatants Combatant[]

  @@index([status])
  @@map("combats")
}

model Combatant {
  id       String  @id @default(cuid())
  combatId String
  combat   Combat  @relation(fields: [combatId], references: [id], onDelete: Cascade)

  kind CombatantKind

  // Se a ficha/criatura for removida no meio do combate, o combatente continua
  // existindo (o id vira nulo) para não quebrar a ordem dos turnos.
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  creatureId  String?
  creature    Creature?  @relation(fields: [creatureId], references: [id], onDelete: SetNull)

  /// Nome no momento da entrada em combate (a criatura pode ser renomeada depois).
  /// Várias cópias da mesma criatura entram como "Goblin 1", "Goblin 2"...
  name         String
  ownerUserId  String?
  /// Modificador de Destreza fixado na entrada, usado na iniciativa e no desempate.
  dexterityMod Int     @default(0)

  /// SNAPSHOT de vitais, usado pelas criaturas para que cada cópia tenha a
  /// própria vida. Em personagens fica nulo e a vida é lida ao vivo da ficha.
  hpCurrent  Int?
  hpMax      Int?
  armorClass Int?

  /// Resultados em `null` enquanto o combatente ainda não rolou a iniciativa.
  initiative     Int?
  initiativeRoll Int?

  createdAt DateTime @default(now())

  @@index([combatId])
  @@index([ownerUserId])
  @@map("combatants")
}
