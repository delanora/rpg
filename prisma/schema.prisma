// Schema do Prisma — Codex do Aventureiro
// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Etapa 1 — Usuários e autenticação
// -----------------------------------------------------------------------------

/// Papel do usuário na mesa.
/// - PLAYER: cria e gerencia apenas a própria ficha.
/// - MASTER: enxerga todas as fichas e tem o painel de controle.
enum Role {
  PLAYER
  MASTER
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  displayName  String
  passwordHash String
  role         Role       @default(PLAYER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  character    Character?

  @@index([role])
  @@map("users")
}

// -----------------------------------------------------------------------------
// Etapa 2 — Ficha de personagem
//
// Modelagem híbrida: campos simples e muito consultados ficam em colunas
// (nome, nível, atributos, HP, CA) e as coleções maiores ficam em JSONB,
// validadas por Zod na aplicação. Isso deixa a edição inline e a sincronização
// em tempo real simples, sem dezenas de tabelas auxiliares.
// -----------------------------------------------------------------------------

model Character {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identidade
  name       String @default("Novo Personagem")
  race       String @default("")
  className  String @default("")
  /// Chave canônica da classe (ver src/modules/shared/classes.ts). Vazia = sem classe.
  classKey   String @default("")
  /// Subclasse escolhida (liberada a partir do nível de subclasse da classe).
  subclass   String @default("")
  level      Int    @default(1)
  background String @default("")
  alignment  String @default("")
  experience Int    @default(0)

  // Atributos (1 a 30)
  strength     Int @default(10)
  dexterity    Int @default(10)
  constitution Int @default(10)
  intelligence Int @default(10)
  wisdom       Int @default(10)
  charisma     Int @default(10)

  // Pontos de vida e defesa
  hpCurrent       Int @default(1)
  hpMax           Int @default(1)
  hpTemp          Int @default(0)
  armorClass      Int @default(10)
  initiativeBonus Int @default(0)
  speed           Int @default(30)

  // Coleções (JSONB) — ver src/modules/characters/characters.schema.ts
  skills    Json @default("{}") //  { [skill]: { proficient, expertise } }
  saves     Json @default("{}") //  { [ability]: boolean }
  inventory Json @default("[]") //  [{ id, name, description, quantity, weight, equipped }]
  spells    Json @default("{}") //  { list: [...], slots: { "1": { max, used } } }
  attacks   Json @default("[]") //  [{ id, name, damage, damageType, attackBonus, notes }]
  features  Json @default("[]") //  [{ id, name, source, description }]
  notes     String @default("")
  /// Estado de runtime da classe: toggles ativos (ex.: Fúria) e usos gastos.
  classState Json @default("{}") //  { active: string[], used: { [id]: number } }

  /// URL pública do avatar enviado pelo próprio jogador (`uploads/characters/...`).
  avatarUrl String @default("")

  /// Incrementado a cada alteração; ajuda a ordenar eventos em tempo real.
  version    Int         @default(1)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  combatants Combatant[]

  @@map("characters")
}

// -----------------------------------------------------------------------------
// Etapa 3 — Criaturas e NPCs (cadastrados pelo mestre)
//
// Segue a mesma modelagem híbrida da ficha: atributos e vitais em colunas,
// ataques/resistências/imunidades em JSONB. As criaturas ficam disponíveis
// para o sistema de combate da Etapa 4.
//
// Criaturas e NPCs compartilham os mesmos campos; o que os separa é o `kind`.
// NPCs são entidades narrativas e podem ser vinculados a localidades.
// -----------------------------------------------------------------------------

/// Separa monstros de combate (CREATURE) de personagens narrativos (NPC).
enum CreatureKind {
  CREATURE
  NPC
}

/// Local do mundo (cidade, masmorra, taverna...) com uma ou mais imagens.
model Locality {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  /// Lista de imagens: [{ url, name }]. Os arquivos ficam em `uploads/`.
  images      Json     @default("[]")
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creatures Creature[]
  combats   Combat[]

  @@index([name])
  @@map("localities")
}

model Creature {
  id String @id @default(cuid())

  // Identificação
  name            String
  kind            CreatureKind @default(CREATURE)
  type            String @default("") // ex.: Humanoide, Besta, Dragão
  challengeRating String @default("") // Nível de Desafio (ND), ex.: "1/2", "5"

  // Atributos (1 a 30)
  strength     Int @default(10)
  dexterity    Int @default(10)
  constitution Int @default(10)
  intelligence Int @default(10)
  wisdom       Int @default(10)
  charisma     Int @default(10)

  // Pontos de vida e defesa
  hpCurrent  Int @default(1)
  hpMax      Int @default(1)
  armorClass Int @default(10)
  speed      Int @default(30)

  // Coleções (JSONB) — ver src/modules/shared/attacks.ts
  attacks     Json @default("[]") // [{ id, name, damage, damageType, attackBonus, notes }]
  resistances Json @default("[]") // tipos de dano resistidos
  immunities  Json @default("[]") // tipos de dano imunes
  description String @default("")

  /// URL pública do ícone/retrato da criatura/NPC (`uploads/creatures/...`).
  imageUrl String @default("")

  /// Localidades às quais esta criatura/NPC pertence (uma ou mais).
  localities Locality[]

  /// Incrementado a cada alteração; ajuda a ordenar eventos em tempo real.
  version    Int         @default(1)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  combatants Combatant[]

  @@index([name])
  @@index([kind])
  @@map("creatures")
}

/// Item do catálogo central gerenciado pelo mestre (armas, poções, tesouros...).
/// Pode ter um sprite e ser enviado direto para o inventário de um jogador.
model Item {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  /// Peso em libras (aceita frações, como 0.5).
  weight      Float    @default(0)
  /// Categoria validada na aplicação (ex.: Arma, Poção, Tesouro).
  category    String   @default("Item Geral")
  /// URL pública do sprite do item (`uploads/items/...`).
  imageUrl    String   @default("")
  /// Atributos específicos da categoria: dano, CA adicional, rolagem de efeito...
  /// Ver src/modules/shared/item-details.ts.
  details     Json     @default("{}")
  /// Preço em peças de ouro, prata e cobre (informação exclusiva do mestre).
  priceGold   Int      @default(0)
  priceSilver Int      @default(0)
  priceCopper Int      @default(0)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@map("items")
}

// -----------------------------------------------------------------------------
// Etapa 4 — Combate
//
// Um combate ativo por vez. O HP NÃO é duplicado aqui: o combatente guarda
// apenas identidade e iniciativa, e o HP é lido ao vivo da ficha ou da criatura.
// Assim não existe segunda fonte de verdade para os pontos de vida.
// -----------------------------------------------------------------------------

enum CombatStatus {
  PENDING_INITIATIVE // aguardando todas as iniciativas serem roladas
  ACTIVE // ordem montada, turnos em andamento
  ENDED
}

enum CombatantKind {
  CHARACTER
  CREATURE
}

model Combat {
  id           String       @id @default(cuid())
  status       CombatStatus @default(PENDING_INITIATIVE)
  round        Int          @default(1)
  /// Posição na ordem calculada (ordenada por iniciativa).
  currentIndex Int          @default(0)

  /// Localidade onde o combate acontece (opcional, informada na preparação).
  localityId String?
  locality   Locality? @relation(fields: [localityId], references: [id], onDelete: SetNull)

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  endedAt    DateTime?
  combatants Combatant[]

  @@index([status])
  @@map("combats")
}

model Combatant {
  id       String  @id @default(cuid())
  combatId String
  combat   Combat  @relation(fields: [combatId], references: [id], onDelete: Cascade)

  kind CombatantKind

  // Se a ficha/criatura for removida no meio do combate, o combatente continua
  // existindo (o id vira nulo) para não quebrar a ordem dos turnos.
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  creatureId  String?
  creature    Creature?  @relation(fields: [creatureId], references: [id], onDelete: SetNull)

  /// Nome no momento da entrada em combate (a criatura pode ser renomeada depois).
  /// Várias cópias da mesma criatura entram como "Goblin 1", "Goblin 2"...
  name         String
  ownerUserId  String?
  /// Modificador de Destreza fixado na entrada, usado na iniciativa e no desempate.
  dexterityMod Int     @default(0)

  /// SNAPSHOT de vitais, usado pelas criaturas para que cada cópia tenha a
  /// própria vida. Em personagens fica nulo e a vida é lida ao vivo da ficha.
  hpCurrent  Int?
  hpMax      Int?
  armorClass Int?

  /// Resultados em `null` enquanto o combatente ainda não rolou a iniciativa.
  initiative     Int?
  initiativeRoll Int?

  createdAt DateTime @default(now())

  @@index([combatId])
  @@index([ownerUserId])
  @@map("combatants")
}
