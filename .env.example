# Ambiente de execução: development | test | production
# OPCIONAL: deixe em branco/comentado. O padrão é development; o serviço systemd
# (deploy/grimorio.service) define NODE_ENV=production. Como o EnvironmentFile tem
# precedência sobre o Environment do unit, definir a linha aqui forçaria o valor
# em TODOS os contextos, inclusive no serviço.
# NODE_ENV=development

# Porta do servidor HTTP (Express + Socket.io compartilham a mesma porta)
PORT=3000

# Conexão com o PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grimorio?schema=public"

# Origem(ns) permitida(s) para CORS. Use * em desenvolvimento;
# em produção informe o domínio do frontend, separando por vírgula se houver mais de um.
CORS_ORIGIN=*

# --- Autenticação ---
# Segredo usado para assinar os tokens JWT. Gere um valor aleatório e longo,
# por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Validade do token (formato aceito por jsonwebtoken: 15m, 24h, 7d...)
JWT_EXPIRES_IN=7d
# Código necessário para registrar uma conta de Mestre (papel master).
# Deixe em branco/remova para impedir cadastro de mestre pela API.
MASTER_INVITE_CODE=defina-um-codigo-de-mestre
